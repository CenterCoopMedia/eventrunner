{
  "functions": {
    "source": "functions",
    "codebase": "default",
    "predeploy": ["node \"$PROJECT_DIR/scripts/prepare-functions.cjs\""],
    "ignore": ["node_modules", ".git", "vendor/*.tgz.tmp", "**/*.test.cjs"]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "target": "site",
    "public": "apps/web/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/updates/**",
        "function": {
          "functionId": "updatesMeta",
          "region": "us-central1"
        }
      },
      { "source": "/signin", "destination": "/index.html" },
      { "source": "/profile", "destination": "/index.html" },
      { "source": "/profile/**", "destination": "/index.html" },
      { "source": "/attendees", "destination": "/index.html" },
      { "source": "/attendees/**", "destination": "/index.html" },
      { "source": "/schedule/mine", "destination": "/index.html" },
      { "source": "/speaker/**", "destination": "/index.html" },
      { "source": "/ticket/**", "destination": "/index.html" },
      { "source": "/admin", "destination": "/index.html" },
      { "source": "/admin/**", "destination": "/index.html" },
      {
        "source": "/unsubscribe",
        "function": {
          "functionId": "emailUnsubscribe",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "function": {
          "functionId": "routeMeta",
          "region": "us-central1"
        }
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
          { "key": "X-Frame-Options", "value": "DENY" }
        ]
      },
      {
        "source": "/signin",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }, { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, must-revalidate" }]
      },
      {
        "source": "/profile",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }, { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, must-revalidate" }]
      },
      {
        "source": "/profile/**",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }, { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, must-revalidate" }]
      },
      {
        "source": "/attendees",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }, { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, must-revalidate" }]
      },
      {
        "source": "/attendees/**",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }, { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, must-revalidate" }]
      },
      {
        "source": "/schedule/mine",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }, { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, must-revalidate" }]
      },
      {
        "source": "/speaker/**",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }, { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, must-revalidate" }]
      },
      {
        "source": "/ticket/**",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }, { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, must-revalidate" }]
      },
      {
        "source": "/admin",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }, { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, must-revalidate" }]
      },
      {
        "source": "/admin/**",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }, { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, must-revalidate" }]
      },
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, must-revalidate" }]
      },
      {
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, s-maxage=300, must-revalidate" }]
      },
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "/fonts/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=2592000" }
        ]
      },
      {
        "source": "/unsubscribe",
        "headers": [
          { "key": "X-Robots-Tag", "value": "noindex" },
          { "key": "Cache-Control", "value": "no-store" }
        ]
      }
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "functions": { "port": 5001 },
    "ui": { "enabled": true }
  }
}
