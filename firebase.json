{
  "functions": {
    "source": "functions",
    "codebase": "default",
    "predeploy": ["node \"$PROJECT_DIR/scripts/prepare-functions.cjs\""],
    "ignore": ["node_modules", ".git", "vendor/*.tgz.tmp", "**/*.test.cjs"]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "ui": { "enabled": true }
  }
}
