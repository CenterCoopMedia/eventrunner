# Run of Show — Tier A deploy-time configuration (spec §2.1)
#
# One GitHub Environment per client deployment holds these as variables and
# secrets. This file documents the full set; packages/shared/src/config/deploy.cjs
# validates it and fails the build loudly on a missing required key.
#
# Nothing in this file is event *content* — dates, venue, sender identity, and
# everything a client admin can edit live in Firestore config/* (Tier B, §2.2).

# --- Identity / project (required) ---
EVENT_SLUG=demo-event                      # lowercase identifier; log lines + Storage prefixes
EVENT_FIREBASE_PROJECT_ID=
EVENT_FIREBASE_REGION=us-central1
EVENT_HOSTING_SITE=
EVENT_PUBLIC_URL=                          # canonical origin, e.g. https://summit.example.org
EVENT_STORAGE_BUCKET=
EVENT_ALLOWED_ORIGINS=                     # comma-separated origins for CORS

# --- Provider selection (required) ---
EVENT_EMAIL_PROVIDER=console               # postmark | webhook | console
EVENT_TICKETING_PROVIDER=none              # eventbrite | manual | none
EVENT_TICKETING_EVENT_ID=                  # required only when ticketing provider is eventbrite
EVENT_OPERATOR_NOTIFIER=none               # webhook | email | none

# --- OTP abuse controls (optional; safe defaults) ---
# The per-address bucket (5 requests / 15 minutes) is a per-victim control:
# a caller working through a list of distinct addresses never trips it. These
# two deploy-time controls sit underneath it. See docs/adr §3.1.
EVENT_APP_CHECK_ENFORCED=false             # true → sendOtpCode/verifyOtpCode
                                           # reject unattested callers. Requires
                                           # VITE_FIREBASE_APP_CHECK_SITE_KEY below
                                           # and an App Check-registered web app;
                                           # turning it on without both locks the
                                           # sign-in page out. Only the literal
                                           # "true" enables it.
EVENT_OTP_SEND_CEILING_PER_HOUR=500        # deployment-wide ceiling on total OTP
                                           # sends per rolling hour. Over it, every
                                           # request gets the same generic
                                           # rate-limited answer and the operator is
                                           # notified once per trip. Absent, zero, or
                                           # unparseable falls back to 500 — there is
                                           # no "unlimited" setting.
# Optional infra alternative, deliberately NOT implemented in this repo:
# per-IP limiting via Cloud Armor (or an edge/WAF rule) in front of the
# functions. It is the right control for a volumetric flood from few sources,
# but it is billed per-policy, is configured outside this repo, and does not
# help against a distributed request pattern — which is what App Check and the
# global ceiling above are for. Add it at the load balancer if a deployment
# needs it; no code change here.

# --- Frontend build (required) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_EVENT_PUBLIC_URL=                     # mirrors EVENT_PUBLIC_URL into the bundle

# --- Frontend build (optional) ---
# VITE_FIREBASE_REGION mirrors EVENT_FIREBASE_REGION into the bundle — read
# by apps/web/src/contexts/AuthContext.jsx to build the deployed functions'
# origin (https://<region>-<project>.cloudfunctions.net). Defaults to
# us-central1 when unset; only needs setting when EVENT_FIREBASE_REGION is
# something else.
VITE_FIREBASE_REGION=

# --- Frontend App Check (optional) ---
# The client half of EVENT_APP_CHECK_ENFORCED above; set this key first.
VITE_FIREBASE_APP_CHECK_SITE_KEY=          # reCAPTCHA v3 site key, non-secret. Unset
                                           # → the App Check SDK is never loaded and
                                           # the client behaves exactly as today.
                                           # Complete a deploy with this set before
                                           # enabling EVENT_APP_CHECK_ENFORCED.
VITE_APP_CHECK_DEBUG_TOKEN=                # local/CI only; never set in production

# --- Secrets (GitHub Environment secrets / Secret Manager — never committed) ---
# Deploy auth is Workload Identity Federation (docs/DEPLOY_RUNBOOK.md), not
# a service-account key — there is no FIREBASE_SERVICE_ACCOUNT secret.
# EMAIL_PROVIDER_API_KEY                   # when email provider is postmark
# EMAIL_WEBHOOK_BASIC_AUTH                 # user:pass — only with postmark delivery ingest
# EMAIL_WEBHOOK_URL / EMAIL_WEBHOOK_SECRET # only when email provider is webhook
# TICKETING_API_TOKEN                      # only when ticketing provider is not none
# TICKETING_WEBHOOK_SECRET                 # only when the provider implements registerWebhook
# OPERATOR_WEBHOOK_URL / OPERATOR_WEBHOOK_SECRET  # only when notifier is webhook
