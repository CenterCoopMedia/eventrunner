rules_version = '2';

// Security rules of the client console project (ADR 0007 §2). Not the
// client event rules: those are the root firestore.rules.
//
// The console's server functions own every write (console/functions).
// The browser may only read:
//   - a member reads its own organization and that organization's members;
//   - an operator (a lowercase email in console_config/operators) reads
//     every organization and every member;
//   - a member reads its own organization's applications, and an operator
//     reads every application;
//   - an operator reads the console audit log.
// Invites, web-address names (checkWebAddress answers on the server), the
// operator allowlist, the console settings, the rate limits, and the private
// parts of connected accounts have no client access at all. Every read needs
// a verified email address.
//
// Tests: console/tests/console.rules.test.js (npm run test:rules).

service cloud.firestore {
  match /databases/{database}/documents {

    function verified() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function isOperator() {
      let operators = /databases/$(database)/documents/console_config/operators;
      return verified()
        && exists(operators)
        && get(operators).data.emails is list
        && request.auth.token.email.lower() in get(operators).data.emails;
    }

    function isMember(orgId) {
      return verified()
        && exists(/databases/$(database)/documents/organizations/$(orgId)/members/$(request.auth.uid));
    }

    match /organizations/{orgId} {
      allow get: if isMember(orgId) || isOperator();
      allow list: if isOperator();
      allow write: if false;

      match /members/{uid} {
        allow read: if isMember(orgId) || isOperator();
        allow write: if false;
      }
    }

    // "Every member of every organization", for an operator only.
    match /{path=**}/members/{uid} {
      allow read: if isOperator();
    }

    // A guided-setup request (ADR 0007 §3). A list must ask for one
    // organization (where orgId ==), so a member never lists another's.
    match /applications/{appId} {
      allow read: if isOperator() || isMember(resource.data.orgId);
      allow write: if false;
    }

    // Connected accounts (ADR 0007 §4). A member reads connection state on
    // the application. The account ids and the half-finished connections
    // stay here, for the functions only, operators included.
    match /console_connections/{appId} {
      allow read, write: if false;
    }

    match /console_connection_states/{stateHash} {
      allow read, write: if false;
    }

    // Tokens of deleted requests, until they are deleted.
    match /console_token_deletions/{appId} {
      allow read, write: if false;
    }

    match /site_names/{name} {
      allow read, write: if false;
    }

    match /invites/{inviteId} {
      allow read, write: if false;
    }

    // Includes console_config/agreement/versions/{version}.
    match /console_config/{document=**} {
      allow read, write: if false;
    }

    // The signed record of each acceptance (ADR 0007, amendment 2026-11-04).
    match /agreement_acceptances/{id} {
      allow read, write: if false;
    }

    // One record for each paid session the server has handled.
    match /console_fee_events/{sessionId} {
      allow read, write: if false;
    }

    match /console_rate_limits/{key} {
      allow read, write: if false;
    }

    // Operator review (ADR 0007 §5). The review functions write the
    // audit log; an operator reads it.
    match /console_audit/{entryId} {
      allow read: if isOperator();
      allow write: if false;
    }
  }
}
