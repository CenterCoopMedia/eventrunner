{
  "functions": {
    "source": "functions",
    "codebase": "console",
    "predeploy": ["node \"$PROJECT_DIR/../scripts/prepare-functions.cjs\""],
    "ignore": ["node_modules", ".git", "**/*.test.cjs", "src/fake*.cjs", "src/testData.cjs"]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "web/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/listOrganizations", "function": { "functionId": "listOrganizations", "region": "us-central1" } },
      { "source": "/api/createOrganization", "function": { "functionId": "createOrganization", "region": "us-central1" } },
      { "source": "/api/getTeam", "function": { "functionId": "getTeam", "region": "us-central1" } },
      { "source": "/api/inviteMember", "function": { "functionId": "inviteMember", "region": "us-central1" } },
      { "source": "/api/acceptInvite", "function": { "functionId": "acceptInvite", "region": "us-central1" } },
      { "source": "/api/changeMemberRole", "function": { "functionId": "changeMemberRole", "region": "us-central1" } },
      { "source": "/api/removeMember", "function": { "functionId": "removeMember", "region": "us-central1" } },
      { "source": "/api/createApplication", "function": { "functionId": "createApplication", "region": "us-central1" } },
      { "source": "/api/getApplication", "function": { "functionId": "getApplication", "region": "us-central1" } },
      { "source": "/api/listApplications", "function": { "functionId": "listApplications", "region": "us-central1" } },
      { "source": "/api/saveApplicationStep", "function": { "functionId": "saveApplicationStep", "region": "us-central1" } },
      { "source": "/api/checkWebAddress", "function": { "functionId": "checkWebAddress", "region": "us-central1" } },
      { "source": "/api/submitApplication", "function": { "functionId": "submitApplication", "region": "us-central1" } },
      { "source": "/api/withdrawApplication", "function": { "functionId": "withdrawApplication", "region": "us-central1" } },
      { "source": "/api/listApplicationsForReview", "function": { "functionId": "listApplicationsForReview", "region": "us-central1" } },
      { "source": "/api/getApplicationForReview", "function": { "functionId": "getApplicationForReview", "region": "us-central1" } },
      { "source": "/api/requestChanges", "function": { "functionId": "requestChanges", "region": "us-central1" } },
      { "source": "/api/declineApplication", "function": { "functionId": "declineApplication", "region": "us-central1" } },
      { "source": "/api/approveApplication", "function": { "functionId": "approveApplication", "region": "us-central1" } },
      { "source": "/api/deleteSpamApplication", "function": { "functionId": "deleteSpamApplication", "region": "us-central1" } },
      { "source": "/api/getConsoleSettings", "function": { "functionId": "getConsoleSettings", "region": "us-central1" } },
      { "source": "/api/saveConsoleSettings", "function": { "functionId": "saveConsoleSettings", "region": "us-central1" } },
      { "source": "/api/getAgreement", "function": { "functionId": "getAgreement", "region": "us-central1" } },
      { "source": "/api/acceptAgreement", "function": { "functionId": "acceptAgreement", "region": "us-central1" } },
      { "source": "/api/reopenApplication", "function": { "functionId": "reopenApplication", "region": "us-central1" } },
      { "source": "/api/startFeeCheckout", "function": { "functionId": "startFeeCheckout", "region": "us-central1" } },
      { "source": "/api/saveEventFee", "function": { "functionId": "saveEventFee", "region": "us-central1" } },
      { "source": "/api/saveAgreement", "function": { "functionId": "saveAgreement", "region": "us-central1" } },
      { "source": "/api/consoleFeeWebhook", "function": { "functionId": "consoleFeeWebhook", "region": "us-central1" } },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "X-Robots-Tag", "value": "noindex" },
          { "key": "Referrer-Policy", "value": "no-referrer" }
        ]
      }
    ]
  },
  "emulators": {
    "auth": { "port": 9099 },
    "firestore": { "port": 8080 },
    "functions": { "port": 5001 },
    "hosting": { "port": 5002 },
    "ui": { "enabled": true }
  }
}
