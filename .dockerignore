# Build context for publisher/Dockerfile (spec §8.4 phase 5).
#
# node_modules is excluded so the image's dependency tree always comes from
# `npm ci` against the committed lockfile rather than from whatever the
# builder happened to have installed — a runner's tree can contain
# platform-specific binaries and, on a local build, uncommitted changes.

node_modules
**/node_modules
.git
.github
apps/web/dist
functions/.env.*
# Local env files. .gitignore already ignores these. The image copies the
# workspace, so a developer file must not be baked in. .env.example is
# committed and is not a secret, so it stays.
.env
.env.*
!.env.example
# google-github-actions/auth writes this file into the workspace before
# the publisher image is built. COPY . would bake it into the image.
gha-creds-*.json
*.log
