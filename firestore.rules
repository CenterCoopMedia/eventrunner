rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // v1 rules per docs/adr/0001-event-platform-v1.md §4 and §8.4.
    // All writes go through the Admin SDK (callable/HTTP functions);
    // clients never write Firestore directly.

    // adminEmails on config/bootstrap MUST be stored lowercase: rules can
    // lowercase the token email (string.lower()) but cannot map over the
    // stored list, so the lowercase-storage convention carries the other
    // half of the case-insensitive match (server-side requireAdmin
    // lowercases both sides).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/config/bootstrap)
             .data.adminEmails.hasAny([request.auth.token.email.lower()]);
    }

    // config/* is public runtime configuration, EXCEPT config/bootstrap,
    // which holds the admin allowlist and is server-only: no client read,
    // not even for admins (the token check happens server-side).
    match /config/{docId} {
      allow read: if docId != 'bootstrap';
      allow write: if false;
    }

    // Publishable collections (§8.4 two-revision model): the live doc is
    // anonymously readable only while visible; the draft sibling is never
    // anonymously readable. Writes happen only via cmsPublish / cmsUpdate*
    // through the Admin SDK.
    match /cmsContent/{docId} {
      allow read: if resource.data.visible == true;
      allow read: if isAdmin();
      allow write: if false;
    }
    match /cmsContent_drafts/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /cmsSchedule/{docId} {
      allow read: if resource.data.visible == true;
      allow read: if isAdmin();
      allow write: if false;
    }
    match /cmsSchedule_drafts/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /cmsOrganizations/{docId} {
      allow read: if resource.data.visible == true;
      allow read: if isAdmin();
      allow write: if false;
    }
    match /cmsOrganizations_drafts/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /cmsTimeline/{docId} {
      allow read: if resource.data.visible == true;
      allow read: if isAdmin();
      allow write: if false;
    }
    match /cmsTimeline_drafts/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /cmsUpdates/{docId} {
      allow read: if resource.data.visible == true;
      allow read: if isAdmin();
      allow write: if false;
    }
    match /cmsUpdates_drafts/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /cmsPages/{docId} {
      allow read: if resource.data.visible == true;
      allow read: if isAdmin();
      allow write: if false;
    }
    match /cmsPages_drafts/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Publish bookkeeping: admin-readable for the CMS UI, written only by
    // the Admin SDK.
    match /cmsVersionHistory/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /cmsPublishQueue/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /admin_logs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Attendee accounts and their public projection (spec §3.4, §4.1).
    //
    // users/{uid} is the account record. The owner reads and edits their own
    // profile fields; everything else about the account is server-owned —
    // `speakerId`, `registrationStatus`, `approvalSource`, `role`, `email`,
    // and the derived `profileComplete` are written only by the
    // invite/approval transactions and the users/ triggers (§3.4, §4.3). The
    // update rule therefore enumerates what the owner MAY change and denies
    // the write when any other key is touched; the list mirrors
    // SELF_EDITABLE_PROFILE_FIELDS in packages/shared/src/profile.cjs, which
    // rules cannot import.
    function isSelf(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function editsOnlySelfProfileFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName', 'pronouns', 'bio', 'organization', 'jobTitle',
        'photoPath', 'socialHandles', 'badges', 'profileVisibility', 'updatedAt'
      ]);
    }

    // TYPES matter as much as the field list. Every field here is projected
    // into users_public and rendered by the directory, so a map or an array
    // written into `bio` through the SDK would be handed to React as a child
    // and break the directory for every visitor. The projection coerces
    // these too (packages/shared/src/profile.cjs) — this is the boundary
    // check, that is the belt.
    //
    // Badge IDs are not checked against config/badges here: rules cannot
    // read that document for a list-membership test cheaply, and there is
    // no per-element loop in this rules language to type-check each entry
    // of a variable-length list the way `socialHandles` is only checked
    // "is map" and not per-key (§4.5). Full membership + per-category
    // maxPicks enforcement happens where it CAN read the live config: the
    // syncUserPublic trigger rewrites users_public.badges to the
    // intersection with the configured set (packages/shared/src/badges.cjs,
    // functions/src/users/projection.cjs), and every page that renders a
    // stored badges list re-filters through that same config before display
    // (apps/web/src/lib/badgeDisplay.js) so a stale or unconfigured id is
    // never shown even between one edit and the next. What this boundary
    // CAN afford cheaply, and does: reject anything that is not a list,
    // reject duplicates, and cap its length. The cap (40) is a literal here
    // because rules cannot `require()` packages/shared/src/badges.cjs — it
    // MUST equal that module's exported `MAX_TOTAL_BADGES`, the same bound
    // config/schema.cjs's validateBadgesConfig enforces on the sum of every
    // category's maxPicks, so a config the admin form accepts can never
    // produce a legitimate selection this boundary would reject.
    // packages/shared/src/badges.test.cjs pins these two numbers equal so
    // they cannot drift apart unnoticed.
    // .get(field, <default of the right type>) so a field the account
    // document happens not to carry is "absent", not a rule error — the
    // check is about what a client may WRITE, not about repairing a
    // half-seeded document.
    function validBadgesList() {
      let badges = request.resource.data.get('badges', []);
      return badges is list
        && badges.size() <= 40
        && badges.toSet().size() == badges.size();
    }

    function validSelfProfileTypes() {
      let d = request.resource.data;
      return d.get('displayName', '') is string
        && d.get('pronouns', '') is string
        && d.get('bio', '') is string
        && d.get('organization', '') is string
        && d.get('jobTitle', '') is string
        && (d.get('photoPath', null) == null || d.get('photoPath', '') is string)
        && d.get('socialHandles', {}) is map
        && validBadgesList()
        && (d.get('updatedAt', null) == null || d.get('updatedAt', null) is timestamp)
        && d.profileVisibility in ['public', 'attendees_only', 'private'];
    }

    // config/features.publicAttendeeProfiles is an operator decision: when
    // it is off, no client may move their profile TO `public` and publish
    // themselves to the open web. Only the transition is gated — a profile
    // already stored as `public` (chosen while the feature was on) stays
    // editable, so turning the flag off does not lock those accounts out of
    // their own profile. Costs one document read, and only on a write that
    // asks for `public`. A missing or half-seeded config/features fails
    // closed for `public` and for nothing else.
    function publicProfilesEnabled() {
      return exists(/databases/$(database)/documents/config/features)
        && get(/databases/$(database)/documents/config/features)
             .data.get('publicAttendeeProfiles', false) == true;
    }

    function validSelfProfileValues() {
      return validSelfProfileTypes()
        && (request.resource.data.profileVisibility != 'public'
            || resource.data.profileVisibility == 'public'
            || publicProfilesEnabled());
    }

    match /users/{userId} {
      allow read: if isSelf(userId);
      allow read: if isAdmin();
      // Account creation belongs to the auth trigger (users/lifecycle.cjs):
      // a client that could create its own document could create it
      // `approved`. Deletion is an admin/server operation for the same reason.
      allow create, delete: if false;
      allow update: if isSelf(userId)
        && editsOnlySelfProfileFields()
        && validSelfProfileValues();

      // Private per-session bookmark membership (spec §4.1, §9). Every WRITE
      // goes through the Admin SDK (bookmarkSession, functions/src/schedule/
      // bookmarks.cjs) — the owner only ever reads their own docs here, so
      // the "my schedule" view can subscribe directly instead of polling a
      // callable.
      match /bookmarks/{sessionId} {
        allow read: if isSelf(userId);
        allow write: if false;
      }
    }

    // The requester's OWN registration state, read from their users doc.
    // .get(field, default) rather than direct access: a half-seeded account
    // document must evaluate to "not an approved attendee", not to a rule
    // error. Costs one document read per attendees_only profile read — the
    // same cost isAdmin() already pays, which is why the directory queries
    // users_public once instead of per card (§3.4).
    function requesterUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function requesterIsApprovedAttendee() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (requesterUserDoc().get('registrationStatus', '') == 'approved'
            || requesterUserDoc().get('speakerId', null) != null);
    }

    // users_public/{uid}: trigger-maintained projection, the only attendee
    // document a client may read about somebody else. Before v1 this granted
    // `attendees_only` profiles to ANY authenticated user, so every new
    // (pending) account could enumerate the directory; the approved-attendee
    // branch below is that fix (§3.4).
    //
    // A `list` query succeeds only when every returned document satisfies a
    // rule, so the directory query filters on profileVisibility explicitly
    // rather than relying on these rules to drop rows.
    match /users_public/{userId} {
      allow read: if resource.data.profileVisibility == 'public';
      allow read: if isSelf(userId);
      allow read: if resource.data.profileVisibility == 'attendees_only'
        && requesterIsApprovedAttendee();
      allow read: if isAdmin();
      allow write: if false;
    }

    // Canonical speakers and their public projection (spec §4.3).
    //
    // speakers/{speakerId} is the single source of truth. It carries the
    // pipeline state clients must never see — `email`, `inviteToken`,
    // `approvedAt`, and `uid`, the server-owned half of the
    // users.speakerId ↔ speakers.uid pair — so it is NOT anonymously or
    // attendee-readable. Admins read it (the admin speakers list and the
    // session editor's speaker typeahead subscribe to it directly, exactly
    // as they do to the admin-only `_drafts` collections); nobody writes
    // it from a client. Every write is a Cloud Function: createSpeaker,
    // updateSpeaker, deleteSpeaker, and the invite/acceptance transaction.
    //
    // That is what makes §4.3's three transactional seams enforceable: a
    // client that could write either document could break a reference
    // outside the transaction that is supposed to own it.
    match /speakers/{speakerId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // speakers_public/{speakerId}: the one-way projection the
    // onSpeakerWritten trigger maintains (functions/src/speakers/
    // projection.cjs). Public by design — it drives the speaker directory
    // and the schedule's speaker names — and carries ONLY the fields on
    // PUBLIC_SPEAKER_FIELDS (packages/shared/src/speaker.cjs). A speaker
    // whose status is not `approved` has no document here at all, which is
    // what makes the soft delete (status 'removed') hide them everywhere.
    match /speakers_public/{speakerId} {
      allow read: if true;
      allow write: if false;
    }

    // Aggregate bookmark counts (spec §4.1, §9) — a plain number per
    // session, harmless to read publicly; only bookmarkSession (Admin SDK)
    // writes it.
    match /sessionBookmarks/{sessionId} {
      allow read: if true;
      allow write: if false;
    }

    // Session materials (spec §4.4, issue #23). Two collections, not four:
    // `session_materials` is fully server-only — every field, including the
    // link URL, lives there, and all client access (including admin/speaker
    // review UIs) goes through Cloud Functions (materials/store.cjs,
    // review.cjs, access.cjs). Making the raw doc server-only is what
    // removes the reason the old URL vault collection existed.
    match /session_materials/{materialId} {
      allow read, write: if false;
    }

    // Trigger-maintained projection (materials/projection.cjs): anonymous
    // read of exactly `{sessionId, type, filename, reviewStatus}`, and only
    // for materials the trigger has already scrubbed and approval-gated —
    // a pending or rejected material has no row here at all. Only the
    // Admin SDK (the trigger) ever writes it.
    match /session_materials_public/{materialId} {
      allow read: if true;
      allow write: if false;
    }

    // Live updates dashboard feed (spec §9 "Live updates card", issue #28):
    // a plain admin-authored feed, not gated editorial content like the CMS
    // two-revision collections above — harmless to read publicly, written
    // only by saveLiveUpdate/deleteLiveUpdate (Admin SDK).
    match /live_updates/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Feedback inbox (spec §9 "Feedback inbox", issue #28): admin-readable
    // for the review tab, never client-writable — submitFeedback (public,
    // unauthenticated) and updateFeedbackStatus (admin) both write through
    // the Admin SDK only.
    match /feedback/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Emoji reaction aggregate + per-user dedup (spec §4.1, §9). The
    // aggregate is a counts-by-emoji object, harmless to read publicly
    // (same reasoning as sessionBookmarks above); only reactToSession
    // (Admin SDK, functions/src/schedule/reactions.cjs) writes it. The
    // nested users/{uid} membership doc records which single emoji (if
    // any) that caller currently has on this session — self-read only, so
    // "which reaction is mine" can be rendered without exposing anyone
    // else's choice, and every write still goes through the same handler.
    match /sessionReactions/{sessionId} {
      allow read: if true;
      allow write: if false;

      match /users/{userId} {
        allow read: if isSelf(userId);
        allow write: if false;
      }
    }

    // Server-only collections, named explicitly so a future edit cannot
    // open them by accident via a broader match.
    match /auth_challenges/{docId} { allow read, write: if false; }
    match /auth_rate_limits/{docId} { allow read, write: if false; }
    match /auth_send_ceiling/{docId} { allow read, write: if false; }
    match /sent_emails/{docId} { allow read, write: if false; }
    match /email_claims/{docId} { allow read, write: if false; }
    match /system_errors/{docId} { allow read, write: if false; }
    match /client_error_rate_limits/{docId} { allow read, write: if false; }
    match /email_templates/{docId} { allow read, write: if false; }
    match /feedback_rate_limits/{docId} { allow read, write: if false; }
    // Slug reservations (`speaker_slugs/{slug}` → `{ speakerId }`), the
    // deterministic-id lock that makes speaker slug uniqueness atomic
    // (functions/src/speakers/profile.cjs). Pure bookkeeping: nothing
    // outside those handlers reads or writes it.
    match /speaker_slugs/{slug} { allow read, write: if false; }
    // Speaker invitations (`speaker_invites/{sha256(token)}`, spec §4.1,
    // issue #21). Server-only in BOTH directions, and the read denial is
    // the load-bearing half: the document id is the digest of a live
    // invite token and the row names the invited address, so a client that
    // could read the collection could enumerate every outstanding
    // invitation. Admins see invite state through listSpeakerInvites
    // (functions/src/speakers/invites.cjs), which returns the status fields
    // and never the id. Every write is the invite/acceptance transaction.
    match /speaker_invites/{tokenHash} { allow read, write: if false; }

    // Everything not matched above stays deny-all.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
