rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // v1 rules per docs/adr/0001-event-platform-v1.md §4 and §8.4.
    // All writes go through the Admin SDK (callable/HTTP functions);
    // clients never write Firestore directly.

    // adminEmails on config/bootstrap MUST be stored lowercase: rules can
    // lowercase the token email (string.lower()) but cannot map over the
    // stored list, so the lowercase-storage convention carries the other
    // half of the case-insensitive match (server-side requireAdmin
    // lowercases both sides).
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/config/bootstrap)
             .data.adminEmails.hasAny([request.auth.token.email.lower()]);
    }

    // config/* is public runtime configuration, EXCEPT config/bootstrap,
    // which holds the admin allowlist and is server-only: no client read,
    // not even for admins (the token check happens server-side).
    match /config/{docId} {
      allow read: if docId != 'bootstrap';
      allow write: if false;
    }

    // Publishable collections (§8.4 two-revision model): the live doc is
    // anonymously readable only while visible; the draft sibling is never
    // anonymously readable. Writes happen only via cmsPublish / cmsUpdate*
    // through the Admin SDK.
    match /cmsContent/{docId} {
      allow read: if resource.data.visible == true;
      allow read: if isAdmin();
      allow write: if false;
    }
    match /cmsContent_drafts/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /cmsSchedule/{docId} {
      allow read: if resource.data.visible == true;
      allow read: if isAdmin();
      allow write: if false;
    }
    match /cmsSchedule_drafts/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /cmsOrganizations/{docId} {
      allow read: if resource.data.visible == true;
      allow read: if isAdmin();
      allow write: if false;
    }
    match /cmsOrganizations_drafts/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /cmsTimeline/{docId} {
      allow read: if resource.data.visible == true;
      allow read: if isAdmin();
      allow write: if false;
    }
    match /cmsTimeline_drafts/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /cmsUpdates/{docId} {
      allow read: if resource.data.visible == true;
      allow read: if isAdmin();
      allow write: if false;
    }
    match /cmsUpdates_drafts/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /cmsPages/{docId} {
      allow read: if resource.data.visible == true;
      allow read: if isAdmin();
      allow write: if false;
    }
    match /cmsPages_drafts/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Publish bookkeeping: admin-readable for the CMS UI, written only by
    // the Admin SDK.
    match /cmsVersionHistory/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /cmsPublishQueue/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /admin_logs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Attendee accounts and their public projection (spec §3.4, §4.1).
    //
    // users/{uid} is the account record. The owner reads and edits their own
    // profile fields; everything else about the account is server-owned —
    // `speakerId`, `registrationStatus`, `approvalSource`, `role`, `email`,
    // and the derived `profileComplete` are written only by the
    // invite/approval transactions and the users/ triggers (§3.4, §4.3). The
    // update rule therefore enumerates what the owner MAY change and denies
    // the write when any other key is touched; the list mirrors
    // SELF_EDITABLE_PROFILE_FIELDS in packages/shared/src/profile.cjs, which
    // rules cannot import.
    function isSelf(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function editsOnlySelfProfileFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'displayName', 'pronouns', 'bio', 'organization', 'jobTitle',
        'photoPath', 'socialHandles', 'badges', 'profileVisibility', 'updatedAt'
      ]);
    }

    // Badge IDS are not checked here: rules cannot read config/badges for a
    // list-membership test cheaply (§4.5). The syncUserPublic trigger
    // rewrites users_public.badges to the intersection with the configured
    // set, so an unconfigured id never becomes public.
    function validSelfProfileValues() {
      return request.resource.data.profileVisibility in ['public', 'attendees_only', 'private']
        && request.resource.data.badges is list;
    }

    match /users/{userId} {
      allow read: if isSelf(userId);
      allow read: if isAdmin();
      // Account creation belongs to the auth trigger (users/lifecycle.cjs):
      // a client that could create its own document could create it
      // `approved`. Deletion is an admin/server operation for the same reason.
      allow create, delete: if false;
      allow update: if isSelf(userId)
        && editsOnlySelfProfileFields()
        && validSelfProfileValues();
    }

    // The requester's OWN registration state, read from their users doc.
    // .get(field, default) rather than direct access: a half-seeded account
    // document must evaluate to "not an approved attendee", not to a rule
    // error. Costs one document read per attendees_only profile read — the
    // same cost isAdmin() already pays, which is why the directory queries
    // users_public once instead of per card (§3.4).
    function requesterUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function requesterIsApprovedAttendee() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (requesterUserDoc().get('registrationStatus', '') == 'approved'
            || requesterUserDoc().get('speakerId', null) != null);
    }

    // users_public/{uid}: trigger-maintained projection, the only attendee
    // document a client may read about somebody else. Before v1 this granted
    // `attendees_only` profiles to ANY authenticated user, so every new
    // (pending) account could enumerate the directory; the approved-attendee
    // branch below is that fix (§3.4).
    //
    // A `list` query succeeds only when every returned document satisfies a
    // rule, so the directory query filters on profileVisibility explicitly
    // rather than relying on these rules to drop rows.
    match /users_public/{userId} {
      allow read: if resource.data.profileVisibility == 'public';
      allow read: if isSelf(userId);
      allow read: if resource.data.profileVisibility == 'attendees_only'
        && requesterIsApprovedAttendee();
      allow read: if isAdmin();
      allow write: if false;
    }

    // Server-only collections, named explicitly so a future edit cannot
    // open them by accident via a broader match.
    match /auth_challenges/{docId} { allow read, write: if false; }
    match /auth_rate_limits/{docId} { allow read, write: if false; }
    match /sent_emails/{docId} { allow read, write: if false; }
    match /email_claims/{docId} { allow read, write: if false; }
    match /system_errors/{docId} { allow read, write: if false; }
    match /email_templates/{docId} { allow read, write: if false; }

    // Everything not matched above stays deny-all.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
